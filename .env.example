# Copy to .env and adjust. Every variable is optional; the values below are the defaults.
LLM_BASE_URL=http://127.0.0.1:8345/v1
LLM_MODEL=qwen
LLM_TEMPERATURE=0

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PERSIST_DIR=chroma_db
# ANTHOLOGY_REPO_PATH=/path/to/acl-anthology
# MAX_PAPERS=10000
EMBEDDING_BATCH_SIZE=256

NUM_RESULTS=10
NUM_CANDIDATES_WITH_AUTHORS=300
MAX_HISTORY_MESSAGES=10
